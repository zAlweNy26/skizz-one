{
  "name": "skizz-one",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nuxi build",
    "dev": "bun run --parallel dev:app dev:realtime",
    "dev:app": "nuxi dev",
    "dev:realtime": "wrangler dev --config realtime/wrangler.jsonc",
    "deploy:realtime": "wrangler deploy --config realtime/wrangler.jsonc",
    "test:realtime": "node realtime/test/sync.e2e.mjs",
    "generate": "nuxi generate",
    "preview": "nuxi preview",
    "postinstall": "nuxi prepare",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "fallow": "fallow",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:unit": "vitest --project unit",
    "test:nuxt": "vitest --project nuxt",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.10.0",
    "@iconify-json/lucide": "^1.2.137",
    "@nuxt/content": "3.14.0",
    "@nuxt/image": "2.1.0",
    "@nuxt/scripts": "1.3.9",
    "@nuxt/ui": "^4.11.2",
    "@nuxthub/core": "0.10.8",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/seo": "^5.3.16",
    "@unhead/vue": "^3.4.1",
    "@vueuse/core": "^15.0.0",
    "@vueuse/integrations": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "@vueuse/router": "^15.0.0",
    "drauu": "https://pkg.pr.new/zAlweNy26/drauu/drauu@main",
    "nuxt": "^4.5.2",
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0",
    "roughjs": "^4.6.6",
    "scule": "^1.3.0",
    "tailwindcss": "^4.3.3",
    "uncrypto": "^0.1.3",
    "unique-names-generator": "^4.7.1",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "4.3.2",
    "@playwright/test": "^1.63.0",
    "@shadcn/lint": "^0.2.0",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.11.0",
    "fallow": "^3.30.0",
    "happy-dom": "^20.14.5",
    "nitro-cloudflare-dev": "^0.2.2",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2",
    "wrangler": "^4.142.0"
  }
}
