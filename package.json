{
  "name": "skizz-one",
  "type": "module",
  "version": "1.4.2",
  "private": true,
  "scripts": {
    "build": "nuxi build",
    "dev": "bun run --parallel dev:app dev:realtime",
    "dev:app": "nuxi dev",
    "dev:realtime": "wrangler dev --config realtime/wrangler.jsonc",
    "deploy:realtime": "wrangler deploy --config realtime/wrangler.jsonc",
    "generate": "nuxi generate",
    "preview": "nuxi preview",
    "postinstall": "nuxi prepare",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "fallow": "fallow",
    "fallow:health": "vitest run && fallow health --coverage coverage/coverage-final.json",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:unit": "vitest --project unit",
    "test:realtime": "vitest --project realtime",
    "test:nuxt": "vitest --project nuxt",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.10.0",
    "@iconify-json/lucide": "^1.2.147",
    "@nuxt/content": "3.16.2",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/seo": "^6.0.1",
    "@unhead/vue": "^3.4.3",
    "@vueuse/core": "^15.0.0",
    "@vueuse/integrations": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "@vueuse/router": "^15.0.0",
    "drauu": "https://pkg.pr.new/zAlweNy26/drauu/drauu@main",
    "nuxt": "^4.6.2",
    "nuxt-security": "^2.6.0",
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0",
    "roughjs": "^4.6.6",
    "scule": "^1.3.0",
    "tailwindcss": "^4.3.3",
    "unique-names-generator": "^4.7.1",
    "uqr": "^0.1.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "4.3.4",
    "@playwright/test": "^1.64.1",
    "@shadcn/lint": "^0.2.3",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "fallow": "^3.34.1",
    "happy-dom": "^21.0.4",
    "playwright-core": "^1.64.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "void": "^1.2.1",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.151.3"
  }
}
