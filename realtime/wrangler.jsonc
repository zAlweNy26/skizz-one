{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skizz-realtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-11",
  "dev": {
    "port": 8787
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GameRoom",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    // Comma-separated.
    "ALLOWED_ORIGINS": "https://skizz.app"
  }
}
